  // ── Mullvad ────────────────────────────────────────────────────────────────
  // Actions run through ~/.local/bin/mullvad-menu, which reports back with
  // notifications and draws its own pickers with omarchy-menu-select.
  "mullvad": {"icon":"󱇱","label":"Mullvad","aliases":["vpn"],"description":"Mullvad VPN","when":"omarchy-cmd-present mullvad"},
  "mullvad.connect": {"icon":"󰄬","label":"Connect","when":"[[ $(mullvad status) != Connected* ]]","action":"mullvad-menu connect"},
  "mullvad.disconnect": {"icon":"󰅖","label":"Disconnect","when":"[[ $(mullvad status) == Connected* ]]","action":"mullvad-menu disconnect"},
  "mullvad.reconnect": {"icon":"󰜉","label":"Reconnect","description":"Rebuild the tunnel on another matching relay","action":"mullvad-menu reconnect"},
  "mullvad.status": {"icon":"󰛳","label":"Status","description":"Show the tunnel state and exit location","action":"mullvad-menu status"},
  "mullvad.location": {"icon":"󰖟","label":"Location","aliases":["relay"],"description":"Choose which relay to exit through"},
  "mullvad.location.country": {"icon":"󰖟","label":"Country","action":"mullvad-menu country"},
  "mullvad.location.city": {"icon":"󰍹","label":"City","action":"mullvad-menu city"},
  "mullvad.location.server": {"icon":"󰛳","label":"Server","description":"Pin the tunnel to one relay hostname","action":"mullvad-menu server"},
  "mullvad.location.custom-list": {"icon":"󰍜","label":"Custom List","when":"[[ -n $(mullvad custom-list list 2>/dev/null) ]]","action":"mullvad-menu custom-list"},
  "mullvad.settings": {"icon":"󰔫","label":"Settings","title":"Mullvad Settings"},
  "mullvad.settings.lockdown": {"icon":"󰟵","label":"Lockdown Mode","description":"Block all traffic while the VPN is down","checked":"[[ $(mullvad lockdown-mode get) == *on ]]","action":"mullvad-menu toggle-lockdown"},
  "mullvad.settings.autoconnect": {"icon":"󰔎","label":"Auto-Connect","description":"Connect as soon as the daemon starts","checked":"[[ $(mullvad auto-connect get) == *on ]]","action":"mullvad-menu toggle-autoconnect"},
  "mullvad.settings.lan": {"icon":"󰛳","label":"Local Network Sharing","description":"Reach printers and NAS while connected","checked":"[[ $(mullvad lan get) == *allow ]]","action":"mullvad-menu toggle-lan"},
  "mullvad.settings.multihop": {"icon":"󰩟","label":"Multihop","description":"Route through an entry relay first","checked":"mullvad relay get | grep -qE 'Multihop state:[[:space:]]+enabled'","action":"mullvad-menu toggle-multihop"},
  "mullvad.settings.daita": {"icon":"󰂵","label":"DAITA","description":"Defence against AI-guided traffic analysis","checked":"mullvad tunnel get | grep -qE 'DAITA:[[:space:]]+true'","action":"mullvad-menu toggle-daita"},
  "mullvad.settings.quantum": {"icon":"󰵮","label":"Quantum Resistance","checked":"mullvad tunnel get | grep -qE 'Quantum resistance:[[:space:]]+on'","action":"mullvad-menu toggle-quantum"},
  "mullvad.account": {"icon":"󰢁","label":"Account","description":"Device name and paid-through date","action":"omarchy-launch-floating-terminal-with-presentation 'mullvad account get'"},
  "mullvad.app": {"icon":"󱇱","label":"Open App","when":"omarchy-cmd-present mullvad-vpn","action":"omarchy-launch-or-focus 'Mullvad VPN' 'uwsm-app -- mullvad-vpn'"},
